# Copy to .env.local in this folder to run against the Java backend.
# Without it the app uses its own in-browser mock and never calls the service.
#
# Nothing here is secret: NEXT_PUBLIC_* is compiled into the browser bundle,
# so credentials must never go in this file. The backend holds those.

NEXT_PUBLIC_ONBOARDING_TRANSPORT=rest
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
